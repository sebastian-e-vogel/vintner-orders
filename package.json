{
  "name": "vintner-orders",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @vintner/api --filter @vintner/web dev",
    "dev:api": "pnpm --filter @vintner/api dev",
    "dev:web": "pnpm --filter @vintner/web dev",
    "build": "pnpm -r build",
    "start:api": "pnpm --filter @vintner/api start:prod",
    "start:web": "pnpm --filter @vintner/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:integration": "pnpm -r --if-present test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @vintner/api db:seed",
    "migration:generate": "pnpm --filter @vintner/api migration:generate",
    "migration:run": "pnpm --filter @vintner/api migration:run",
    "build:contracts": "pnpm --filter @vintner/contracts build",
    "prepare": "pnpm build:contracts",
    "check": "pnpm build:contracts && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
